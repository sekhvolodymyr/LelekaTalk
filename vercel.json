{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{certs/**,phase-one/public/**,**/node_modules/openpgp/dist/openpgp.min.mjs}",
      "maxDuration": 30
    }
  },
  "routes": [{ "src": "/(.*)", "dest": "/api/index?__route=$1" }]
}
